    { "text": "Teacher: Tell me about your school subjects.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-sen-tell-me-about-your-school-subjects.mp3" },
    { "text": "Amy: Hello. My name’s Amy.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-dia1-a1-hello-my-names-amy.mp3" },
    { "text": "Let me tell you about my school subjects.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-dia1-a2-let-me-tell-you-about-my-school-subjects.mp3" },
    { "text": "I study English, Maths, and Vietnamese at school.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-dia1-a3-i-study-english-maths-and-vietnamese-at-school.mp3" },
    { "text": "I also study Science, Art, Music, and P.E.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-dia1-a4-i-also-study-science-art-music-and-pe.mp3" },
    { "text": "My favourite subject is English.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-dia1-a5-my-favourite-subject-is-english.mp3" },
    { "text": "I like English because it is easy.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-dia1-a6-i-like-english-because-it-is-easy.mp3" },
    { "text": "I study English in the classroom.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-dia1-a7-i-study-english-in-the-classroom.mp3" },
    { "text": "I also like Art because it is fun.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-dia1-a8-i-also-like-art-because-it-is-fun.mp3" },
    { "text": "I study Art in the art room.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-dia1-a9-i-study-art-in-the-art-room.mp3" },
    { "text": "Thank you.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r2/l10/r2-l10-dia1-a10-thank-you.mp3" }
