    { "text": "Jill: And what is this?", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-lead2-j3-and-what-is-this.mp3" },
    { "text": "Alice: This is a sofa.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-lead2-a6-this-is-a-sofa.mp3" },
    { "text": "Jill: What is that?", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-lead2-j4-what-is-that.mp3" },
    { "text": "Alice: That is a clock.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-lead2-a7-that-is-a-clock.mp3" },
