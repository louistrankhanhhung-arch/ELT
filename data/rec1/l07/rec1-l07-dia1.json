    { "text": "Teacher: Tell me about your house.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-sen-tell-me-about-yourself.mp3" },
    { "text": "Tom: Hello.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t1-hello.mp3" },
    { "text": "My name is Tom.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t2-my-name-is-tom.mp3" },
    { "text": "I am a boy.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t3-i-am-a-boy.mp3" },
    { "text": "I am a student.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t4-i-am-a-student.mp3" },
    { "text": "I am eight years old.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t5-i-am-eight-years-old.mp3" },
    { "text": "I am happy today.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t6-i-am-happy-today.mp3" },
    { "text": "This is my house.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t7-this-is-my-house.mp3" },
    { "text": "This is a table.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t8-this-is-a-table.mp3" },
    { "text": "This is a chair.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t9-this-is-a-chair.mp3" },
    { "text": "This is a door.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t10-this-is-a-door.mp3" },
    { "text": "This is a window.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t11-this-is-a-window.mp3" },
    { "text": "And this is a clock.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t12-and-this-is-a-clock.mp3" },
    { "text": "I love my house.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t13-i-love-my-house.mp3" },
    { "text": "Thank you.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l07/r1-l07-dia1-t14-thank-you.mp3" }
  ]
