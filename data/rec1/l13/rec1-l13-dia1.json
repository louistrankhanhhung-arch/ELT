  "lines": [
    { "text": "Teacher: Tell me about your family.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-sen-tell-me-about-your-family.mp3" },
    { "text": "Tom: Hello.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t1-hello.mp3" },
    { "text": "My name is Tom.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t2-my-name-is-tom.mp3" },
    { "text": "I am a student.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t3-i-am-a-student.mp3" },
    { "text": "Let me tell you about my family.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t4-let-me-tell-you-about-my-family.mp3" },
    { "text": "This is my father. He is tall.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t5-this-is-my-father-he-is-tall.mp3" },
    { "text": "This is my mother. She is young.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t6-this-is-my-mother-she-is-young.mp3" },
    { "text": "This is my brother. He is short.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t7-this-is-my-brother-he-is-short.mp3" },
    { "text": "This is my sister. She is thin.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t8-this-is-my-sister-she-is-thin.mp3" },
    { "text": "This is my grandfather. He is old.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t9-this-is-my-grandfather-he-is-old.mp3" },
    { "text": "And this is my grandmother. She is fat.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t10-and-this-is-my-grandmother-she-is-fat.mp3" },
    { "text": "I love my family.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t11-i-love-my-family.mp3" },
    { "text": "Thank you.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l13/r1-l13-dia1-t12-thank-you.mp3" }
  ]
}
