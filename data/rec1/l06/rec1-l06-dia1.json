  "lines": [
    { "text": "Teacher: Tell me about yourself.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-sen-tell-me-about-yourself.mp3" },
    { "text": "Tom: Hello.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t1-hello.mp3" },
    { "text": "My name is Tom.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t2-my-name-is-tom.mp3" },
    { "text": "I am a boy.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t3-i-am-a-boy.mp3" },
    { "text": "I am a student.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t4-i-am-a-student.mp3" },
    { "text": "I am eight years old.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t5-i-am-eight-years-old.mp3" },
    { "text": "I am happy today.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t6-i-am-happy-today.mp3" },
    { "text": "I have a book. I have a bag. I have two pens.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t7-i-have-a-book-i-have-a-bag-i-have-two-pens.mp3" },
    { "text": "I have a dog. I have three fish.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t8-i-have-a-dog-i-have-three-fish.mp3" },
    { "text": "I like dogs. I like fish. I also like rabbits.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t9-i-like-dogs-i-like-fish-i-also-like-rabbits.mp3" },
    { "text": "I can read. I can run. I can draw.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t10-i-can-read-i-can-run-i-can-draw.mp3" },
    { "text": "And I can speak English, too.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t11-and-i-can-speak-english-too.mp3" },
    { "text": "Thank you.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l06/r1-l06-dia1-t12-thank-you.mp3" }
  ]
}
