    { "text": "Teacher: Tell me about yourself and what you have.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-sen-tell-me-about-yourself-and-what-you-have.mp3" },
    { "text": "Tom: Hello.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-dia1-t1-hello.mp3" },
    { "text": "My name is Tom.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-dia1-t2-my-name-is-tom.mp3" },
    { "text": "I am a boy.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-dia1-t3-i-am-a-boy.mp3" },
    { "text": "I am a student.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-dia1-t4-i-am-a-student.mp3" },
    { "text": "I am eight years old.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-dia1-t5-i-am-eight-years-old.mp3" },
    { "text": "I am happy today.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-dia1-t6-i-am-happy-today.mp3" },
    { "text": "I have a bag.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-dia1-t7-i-have-a-bag.mp3" },
    { "text": "I have a book.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-dia1-t8-i-have-a-book.mp3" },
    { "text": "I have a pen.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-dia1-t9-i-have-a-pen.mp3" },
    { "text": "And I have a ruler, too.", "audio": "https://pub-af09166f1dd74d53a2042fd46f7462d7.r2.dev/r1/l03/r1-l03-dia1-t10-and-i-have-a-ruler-too.mp3" },
